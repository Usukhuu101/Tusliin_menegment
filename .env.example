# Copy to `.env` and edit.  NEVER commit .env (it is in .gitignore).

# development = also uses REVIEW content (with a warning in the UI)
# production  = ONLY status: ACTIVE knowledge-base documents
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# ---- LLM (optional) -------------------------------------------------------
# Without a key the chatbot runs fully offline (rules + retrieval + reviewed text).
# With a key: Agent 2 extraction + Agent 4 writing + Agent 5 LLM judge use an LLM.
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set.

# (a) FREE: Google Gemini API — key from https://aistudio.google.com/apikey
#     Free tier = Flash / Flash-Lite models with a small daily request quota.
#     NOTE: on the free tier Google may use the (already anonymised) messages to
#     improve its products — read the Gemini API terms before real users.
# GEMINI_API_KEY=
# LLM_MODEL=                         # empty = newest Flash-Lite your key can use

# (b) PAID: Claude
 ANTHROPIC_API_KEY=sk-ant-...

# (c) any other OpenAI-compatible API (Groq, OpenRouter, local Ollama ...):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

LLM_PROVIDER=auto                    # auto | anthropic | gemini | openai_compat | none
RESPONSE_MODEL=claude-opus-5-5       # writes the answer users read
RESPONSE_EFFORT=medium               # low | medium | high
EXTRACTION_MODEL=claude-haiku-5-5    # cheap structured extraction
SAFETY_MODEL=claude-haiku-5-5        # LLM safety judge

# ---- Retrieval -------------------------------------------------------------
EMBEDDING_PROVIDER=hashing           # hashing (offline) | sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3          # used only with sentence-transformers
COSINE_THRESHOLD=0.5                 # min lexical similarity when no concept matches
AUTO_REINDEX=true                    # rebuild index on startup when KB files change

# ---- Conversation & privacy -------------------------------------------------
MAX_FOLLOWUP_ROUNDS=2
MAX_FOLLOWUP_QUESTIONS=3
MAX_REGENERATIONS=2
RETENTION_DAYS=30
# STORAGE_DIR=storage                # move outside OneDrive if you see "database is locked"
